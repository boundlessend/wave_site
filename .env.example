# скопируй в .env и подставь значения из Supabase: Project Settings → API.
# без этих переменных игра работает без сети: по ссылке с ?room= через общий
# канал браузера (несколько вкладок одного устройства), без ссылки - локально
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...

# адрес сайта для OG-тегов (необязательно, по умолчанию прод-домен)
# VITE_SITE_URL=https://example.com

# CSP в vercel.json запинен на поддомен конкретного проекта Supabase, а Vercel
# читает файл до сборки: после смены VITE_SUPABASE_URL запусти `npm run sync:csp`
