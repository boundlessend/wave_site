{
  "name": "wave_site",
  "private": true,
  "version": "0.0.0",
  "description": "Онлайн-версия настольной игры «Длина волны»: комната по ссылке, у каждого своё устройство",
  "license": "BSD-3-Clause",
  "repository": { "type": "git", "url": "git+https://github.com/boundlessend/wave_site.git" },
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "check": "tsc -b && node src/game/rules.selfcheck.ts && node src/game/engine.selfcheck.ts && npm run lint",
    "sync:csp": "node scripts/sync-csp.mjs",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@supabase/realtime-js": "^2.108.2",
    "canvas-confetti": "^1.9.4",
    "motion": "^12.42.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
